{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "ghwebapp": {
      "type": "dockerfile.v0",
      "path": "../GH.WebApp/gh.webapp/Dockerfile",
      "context": "../GH.WebApp/gh.webapp",
      "env": {
        "NODE_ENV": "development",
        "services__ghidentityapi__http__0": "{ghidentityserver.bindings.http.url}",
        "services__ghidentityapi__https__0": "{ghidentityserver.bindings.https.url}",
        "PORT": "{ghwebapp.bindings.http.targetPort}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 8000,
          "external": true
        }
      }
    }
