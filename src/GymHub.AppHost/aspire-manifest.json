    "ghidentityserver": {
      "type": "project.v0",
      "path": "../GH.IdentityServer/GH.IdentityServer.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{ghidentityserver.bindings.http.targetPort}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "ghwebapp": {
      "type": "dockerfile.v0",
      "path": "../GH.WebApp/gh.webapp/Dockerfile",
      "context": "../GH.WebApp/gh.webapp",
      "env": {
        "NODE_ENV": "development",
        "services__ghidentityapi__http__0": "{ghidentityserver.bindings.http.url}",
        "services__ghidentityapi__https__0": "{ghidentityserver.bindings.https.url}",
        "PORT": "{ghwebapp.bindings.http.targetPort}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 8000,
          "external": true
        }
      }
    }
