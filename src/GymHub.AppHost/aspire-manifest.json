{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "identityapi": {
      "type": "project.v0",
      "path": "../GH.Identity.API/GH.Identity.API.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{ghidentity.bindings.http.targetPort}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "webapp.client": {
      "type": "dockerfile.v0",
      "path": "../WebApp/webapp.client/Dockerfile",
      "context": "../WebApp/webapp.client",
      "env": {
        "NODE_ENV": "development",
        "services__ghidentity__http__0": "{ghidentity.bindings.http.url}",
        "services__ghidentity__https__0": "{ghidentity.bindings.https.url}",
        "PORT": "{webapp.client.bindings.http.targetPort}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 8000,
          "external": true
        }
      }
    }
  }
}