{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenIdConnect": {
    "Authority": "http://localhost:8080/realms/GH-Test-Realm",
    "ClientId": "test-public-client",
    "ClientSecret": "dhaWLdT3Gu6kTKYfkBMokuOhK8jpzZpQ",
    "Scopes": "openid profile email offline_access"
  },
  "Apis": [
    {
      "ApiPath": "/plan-api/",
      "ApiScopes": "api://plan-api/read-write"
    }
  ],
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "gh-plan-api": {
        "ClusterId": "gh-plan-api",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/planapi/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/planapi"
          }
        ]
      },
      "authRoutes": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "keycloak": {
        "ClusterId": "keycloak",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      }
    },
    "Clusters": {
      "gh-plan-api": {
        "Destinations": {
          "gh-plan-api": {
            "Address": "https://gh-plan-api"
          }
        }
      },
      "authCluster": {
        "Destinations": {
          "authCluster": {
            "Address": "http://keycloak"
          }
        }
      },
      "keycloak": {
        "Destinations": {
          "keycloak": {
            "Address": "http://keycloak"
          }
        }
      }
    }
  }
}
