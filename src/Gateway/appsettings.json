{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenIdConnect": {
    "Authority": "http://localhost:8080/realms/GH-Test-Realm",
    "ClientId": "gymhub-bff",
    "ClientSecret": "",
    "Scopes": "openid profile email"
  },
  "Apis": [
    {
      "ApiPath": "/gh-api/",
      "ApiScopes": ""
    }
  ],
  "AllowedHosts": "*",
  "Gateway": {
    "AllowedHosts": [ "localhost" ]
  },
  "ReverseProxy": {
    "Routes": {
      "gymhub-api": {
        "ClusterId": "gymhub-api",
        "Match": {
          "Path": "/gh-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/gh-api"
          }
        ]
      },
      "stripe-webhook": {
        "ClusterId": "gymhub-api",
        "Match": {
          "Path": "/stripe/webhook",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathSet": "/api/v1/billing/webhooks/stripe"
          }
        ]
      }
    },
    "Clusters": {
      "gymhub-api": {
        "Destinations": {
          "gymhub-api": {
            "Address": "https+http://gymhub-api"
          }
        }
      }
    }
  }
}
