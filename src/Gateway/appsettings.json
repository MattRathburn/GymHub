{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KeycloakAuth": {
    "KC_Authority": "http://localhost:8080/realms/GH-Test-Realm",
    "KC_ClientId": "test-public-client",
    "KC_ClientSecret": "dhaWLdT3Gu6kTKYfkBMokuOhK8jpzZpQ"
  },
  "ReverseProxy": {
    "Routes": {
      "gh-plan-api": {
        "ClusterId": "gh-plan-api",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/planapi/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/planapi"
          }
        ]
      },
      "authRoutes": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "keycloak": {
        "ClusterId": "keycloak",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      }
    },
    "Clusters": {
      "gh-plan-api": {
        "Destinations": {
          "gh-plan-api": {
            "Address": "https://gh-plan-api"
          }
        }
      },
      "authCluster": {
        "Destinations": {
          "authCluster": {
            "Address": "http://keycloak"
          }
        }
      }
    }
  }
}
