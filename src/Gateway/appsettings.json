{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenIdConnect": {
    "Authority": "http://localhost:8080/realms/GH-Test-Realm",
    "ClientId": "gymhub-bff",
    "ClientSecret": "",
    "Scopes": "openid profile email"
  },
  "Apis": [
    {
      "ApiPath": "/gh-api/",
      "ApiScopes": ""
    }
  ],
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "gymhub-api": {
        "ClusterId": "gymhub-api",
        "Match": {
          "Path": "/gh-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/gh-api"
          }
        ]
      },
      "spa": {
        "ClusterId": "gh-webapp-ng",
        "Order": 1000,
        "Match": {
          "Path": "{**catch-all}"
        }
      },
      "authRoutes": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "keycloak": {
        "ClusterId": "keycloak",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      }
    },
    "Clusters": {
      "gymhub-api": {
        "Destinations": {
          "gymhub-api": {
            "Address": "https+http://gymhub-api"
          }
        }
      },
      "gh-webapp-ng": {
        "Destinations": {
          "gh-webapp-ng": {
            "Address": "http://gh-webapp-ng"
          }
        }
      },
      "authCluster": {
        "Destinations": {
          "authCluster": {
            "Address": "http://keycloak"
          }
        }
      },
      "keycloak": {
        "Destinations": {
          "keycloak": {
            "Address": "http://keycloak"
          }
        }
      }
    }
  }
}
